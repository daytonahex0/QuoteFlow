# ── Required ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/quoteflow"
APP_URL="http://localhost:3000"
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=""
# Exactly 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=""
# Protects /api/cron/tick: openssl rand -hex 32
CRON_SECRET=""

# ── Transactional email (Resend) ──────────────────────────
# Required in production for verification, password reset, notifications,
# and follow-ups for businesses without a connected mailbox.
RESEND_API_KEY=""
EMAIL_FROM="QuoteFlow <hello@yourdomain.com>"
# Optional: inbound reply tracking for follow-ups sent via Resend
INBOUND_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# ── Gmail (Google Cloud OAuth client) ─────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Outlook (Microsoft Entra app registration) ────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# ── Billing (Stripe) ──────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
